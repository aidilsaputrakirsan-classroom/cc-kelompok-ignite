# ==================== DATABASE ====================
# Format: postgresql://username:password@host:port/database_name
# Pastikan PostgreSQL sudah running dan database sudah dibuat
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/nama_db

# ==================== JWT CONFIGURATION ====================
# Secret key untuk signing JWT token (minimal 32 karakter)
# Generate dengan: openssl rand -hex 32
SECRET_KEY=your-secret-key-minimum-32-characters-long

# Algorithm untuk JWT
ALGORITHM=HS256

# Token expiration time (dalam menit)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==================== CORS CONFIGURATION ====================
# URL frontend yang diizinkan (pisahkan dengan koma jika banyak)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ==================== PROJECT INFO ====================
# Untuk UMKM: ATHSNACK - UMKM E-Commerce Makanan Khas Balikpapan
PROJECT_NAME=ATHSNACK - UMKM E-Commerce
PROJECT_VERSION=1.0.0